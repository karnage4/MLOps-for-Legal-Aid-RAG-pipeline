# Required provider credentials (replace locally; never commit real keys)
HF_API_TOKEN=
PINECONE_API_KEY=
GROQ_API_KEY=

# Optional generation and evaluation settings
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_ATTEMPTS=3
INFERENCE_MODEL_A=qwen/qwen3.8-27b
INFERENCE_MODEL_B=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b
GROQ_JUDGE_REASONING_EFFORT=low
EVALUATION_QUERY_LIMIT=3
EVALUATION_COOLDOWN_SECONDS=5

# Optional MLflow overrides; blank values use local mlflow.db defaults
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_ID=
MLFLOW_EXPERIMENT_NAME=legal-aid-rag
