PINECONE_API_KEY=
HF_API_TOKEN=
GROQ_API_KEY=
# Optional override; defaults to an active Groq text-generation model.
GROQ_MODEL=qwen/qwen3.8-27b
# Optional bounded retry count for rate limits and transient provider errors.
GROQ_MAX_ATTEMPTS=3
# Optional evaluation settings.
GROQ_JUDGE_MODEL=openai/gpt-oss-20b
GROQ_JUDGE_REASONING_EFFORT=low
EVALUATION_QUERY_LIMIT=3
EVALUATION_COOLDOWN_SECONDS=5
